<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20 removed res.groups.category_id and the ir.rule model entirely:
         record-level filtering now lives in security/ir.access.csv (the unified
         ir.access model). Only the two groups are defined here. -->
    <record id="group_crop_admin" model="res.groups">
        <field name="name">Exchange Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_crop_provider" model="res.groups">
        <field name="name">Exchange Provider (Trader/Exporter)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
