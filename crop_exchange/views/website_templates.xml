<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top website nav link so visitors can actually find the board -->
    <record id="website_menu_exchange" model="website.menu">
        <field name="name">بورصة المحاصيل</field>
        <field name="url">/exchange</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">40</field>
    </record>

    <!-- Provider self-service: a provider's login only has the portal
         group and never sees backend menus, so they reach their own
         crop/price list through this logged-in page instead. -->
    <record id="website_menu_exchange_my" model="website.menu">
        <field name="name">لوحة التاجر</field>
        <field name="url">/exchange/my</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">41</field>
    </record>

    <!-- ===================== Public exchange board (stock-exchange style table) ===================== -->
    <template id="exchange_board_template" name="Crop Exchange Board">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4" dir="rtl">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">بورصة المحاصيل</h1>
                    <a href="/exchange/register" class="btn btn-outline-primary">سجّل كتاجر/مصدّر</a>
                </div>

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>المحصول</th>
                            <th>متوسط السعر</th>
                            <th>عدد العروض</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="board_rows" t-as="row">
                            <tr>
                                <td>
                                    <a t-att-href="'/exchange/crop/%s' % row.crop.id" class="fw-bold text-decoration-none">
                                        <t t-out="row.crop.name"/>
                                    </a>
                                </td>
                                <td>
                                    <t t-out="row.avg_price_text"/>
                                    <t t-out="row.crop.default_uom"/>
                                </td>
                                <td><span class="badge bg-secondary"><t t-out="row.offer_count"/></span></td>
                                <td>
                                    <a t-att-href="'/exchange/crop/%s' % row.crop.id" class="btn btn-sm btn-primary">عرض التجار والأسعار</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p t-if="not board_rows" class="text-muted">لا توجد عروض متاحة حالياً بالبورصة.</p>
            </div>
        </t>
    </template>

    <!-- ===================== Per-crop detail: every provider's price ===================== -->
    <template id="exchange_crop_detail_template" name="Crop Exchange - Crop Detail">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4" dir="rtl">
                <a href="/exchange" class="btn btn-link mb-3">&#8592; رجوع لبورصة المحاصيل</a>
                <h2 class="mb-4"><t t-out="crop.name"/> — عروض التجار والمصدّرين</h2>

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>التاجر / المصدّر</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>الجودة</th>
                            <th>الولاية</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="listings" t-as="listing">
                            <tr>
                                <td><t t-out="listing.provider_id.name"/></td>
                                <td><span t-field="listing.price_per_unit" t-options='{"widget": "monetary", "display_currency": listing.currency_id}'/> / <t t-out="listing.uom"/></td>
                                <td><t t-out="listing.quantity"/></td>
                                <td><t t-out="listing.quality_grade or '-'"/></td>
                                <td><t t-out="listing.state_province.name or '-'"/></td>
                                <td>
                                    <a t-att-href="'/exchange/listing/%s' % listing.id" class="btn btn-sm btn-primary">أبدِ اهتمامك</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p t-if="not listings" class="text-muted">لا توجد عروض متاحة حالياً لهذا المحصول.</p>
            </div>
        </t>
    </template>

    <!-- ===================== Listing detail + interest form ===================== -->
    <template id="exchange_listing_detail_template" name="Crop Listing Detail">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4" dir="rtl">
                <a t-att-href="'/exchange/crop/%s' % listing.crop_id.id" class="btn btn-link mb-3">&#8592; رجوع لعروض <t t-out="listing.crop_id.name"/></a>
                <div class="row">
                    <div class="col-md-6">
                        <h2><t t-out="listing.crop_id.name"/> — <t t-out="listing.provider_id.name"/></h2>
                        <ul class="list-unstyled">
                            <li>الكمية: <t t-out="listing.quantity"/> <t t-out="listing.uom"/></li>
                            <li>السعر: <span t-field="listing.price_per_unit" t-options='{"widget": "monetary", "display_currency": listing.currency_id}'/> لكل وحدة</li>
                            <li t-if="listing.quality_grade">الجودة: <t t-out="listing.quality_grade"/></li>
                            <li>الولاية: <t t-out="listing.state_province.name"/></li>
                            <li t-if="listing.valid_until">العرض ساري حتى: <t t-out="listing.valid_until"/></li>
                        </ul>
                        <p class="text-muted small">
                            ملاحظة: بيانات تواصل التاجر غير معروضة مباشرة. أرسل طلب اهتمام وستتولى إدارة المنصة التواصل وربطكما.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-3">أبدِ اهتمامك بهذا العرض</h5>
                                <p t-if="error" class="text-danger" t-out="error"/>
                                <form t-att-action="'/exchange/listing/%s/interest' % listing.id" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-2">
                                        <label class="form-label">الاسم</label>
                                        <input type="text" name="buyer_name" class="form-control" required="1"/>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">رقم الهاتف / واتساب</label>
                                        <input type="text" name="buyer_phone" class="form-control" required="1"/>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">البريد الإلكتروني (اختياري)</label>
                                        <input type="email" name="buyer_email" class="form-control"/>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">رسالتك</label>
                                        <textarea name="message" class="form-control" rows="3"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">إرسال طلب الاهتمام</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="exchange_interest_thankyou_template" name="Interest Request Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center" dir="rtl">
                <h2>تم إرسال طلبك بنجاح</h2>
                <p class="text-muted">ستتواصل معك إدارة المنصة قريباً لربطك بالتاجر.</p>
                <a href="/exchange" class="btn btn-primary">العودة إلى البورصة</a>
            </div>
        </t>
    </template>

    <!-- ===================== Provider self-service: my crops &amp; prices ===================== -->
    <template id="my_listings_not_provider_template" name="My Listings - Not a Provider">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center" dir="rtl">
                <h2>هذا الحساب غير مسجّل كتاجر/مصدّر</h2>
                <p class="text-muted">إذا كنت تاجراً أو مصدّراً، سجّل أولاً ثم انتظر موافقة الإدارة.</p>
                <a href="/exchange/register" class="btn btn-primary">سجّل كتاجر/مصدّر</a>
            </div>
        </t>
    </template>

    <template id="my_listings_pending_template" name="My Listings - Pending Approval">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center" dir="rtl">
                <h2>طلب تسجيلك قيد المراجعة</h2>
                <p class="text-muted">
                    حالة الطلب حالياً:
                    <span t-if="provider.state == 'pending'">قيد المراجعة من الإدارة</span>
                    <span t-if="provider.state == 'rejected'">مرفوض</span>
                </p>
                <a href="/exchange" class="btn btn-primary">العودة إلى البورصة</a>
            </div>
        </t>
    </template>

    <template id="my_listings_template" name="My Crops &amp; Prices">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4" dir="rtl">
                <h2 class="mb-4">محاصيلي وأسعاري — <t t-out="provider.name"/></h2>

                <table class="table table-hover align-middle mb-5">
                    <thead class="table-light">
                        <tr>
                            <th>المحصول</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>الجودة</th>
                            <th>الولاية</th>
                            <th>الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="listings" t-as="listing">
                            <tr>
                                <td><t t-out="listing.crop_id.name"/></td>
                                <td><span t-field="listing.price_per_unit" t-options='{"widget": "monetary", "display_currency": listing.currency_id}'/> / <t t-out="listing.uom"/></td>
                                <td><t t-out="listing.quantity"/></td>
                                <td><t t-out="listing.quality_grade or '-'"/></td>
                                <td><t t-out="listing.state_province.name or '-'"/></td>
                                <td>
                                    <span t-if="listing.state == 'available'" class="badge bg-success">متاح</span>
                                    <span t-if="listing.state == 'reserved'" class="badge bg-warning">محجوز</span>
                                    <span t-if="listing.state == 'expired'" class="badge bg-secondary">منتهي</span>
                                </td>
                                <td class="d-flex gap-1">
                                    <form t-att-action="'/exchange/my/%s/toggle' % listing.id" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button t-if="listing.state != 'expired'" type="submit" class="btn btn-sm btn-outline-secondary">
                                            <span t-if="listing.state == 'available'">تحديد كمحجوز</span>
                                            <span t-if="listing.state == 'reserved'">إعادة كمتاح</span>
                                        </button>
                                    </form>
                                    <form t-att-action="'/exchange/my/%s/delete' % listing.id" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="not listings">
                            <td colspan="7" class="text-muted">لم تضف أي محصول بعد.</td>
                        </tr>
                    </tbody>
                </table>

                <div class="card" style="max-width: 640px;">
                    <div class="card-body">
                        <h5 class="card-title mb-3">إضافة محصول جديد بسعرك</h5>
                        <form action="/exchange/my/add" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-2">
                                <label class="form-label">المحصول</label>
                                <select name="crop_id" class="form-select" required="1">
                                    <t t-foreach="crops" t-as="crop">
                                        <option t-att-value="crop.id"><t t-out="crop.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">السعر لكل وحدة</label>
                                <input type="number" step="0.01" name="price_per_unit" class="form-control" required="1"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">الكمية (اختياري)</label>
                                <input type="number" step="0.01" name="quantity" class="form-control" value="1"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">الجودة / المواصفة</label>
                                <input type="text" name="quality_grade" class="form-control"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">الولاية</label>
                                <select name="state_province" class="form-select" required="1">
                                    <t t-foreach="states" t-as="st">
                                        <option t-att-value="st.id"><t t-out="st.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">إضافة</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== Provider self-registration ===================== -->
    <template id="provider_register_template" name="Provider Registration">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4" dir="rtl" style="max-width: 640px;">
                <h2 class="mb-3">تسجيل كتاجر / مصدّر</h2>
                <p t-if="error" class="text-danger" t-out="error"/>
                <form action="/exchange/register/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-2">
                        <label class="form-label">اسم العمل / الشركة</label>
                        <input type="text" name="name" class="form-control" required="1"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">نوع الكيان</label>
                        <select name="entity_type" class="form-select">
                            <option value="company">شركة مسجلة</option>
                            <option value="trade_name">اسم تجاري</option>
                            <option value="freelancer">فريلانسر</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">اسم الشخص المسؤول</label>
                        <input type="text" name="contact_name" class="form-control"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">الهاتف</label>
                        <input type="text" name="phone" class="form-control" required="1"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">واتساب</label>
                        <input type="text" name="whatsapp" class="form-control"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" name="email" class="form-control"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">الولاية</label>
                        <input type="text" name="state_province" class="form-control" required="1"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">سنوات الخبرة</label>
                        <input type="number" name="years_experience" class="form-control"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ملاحظات إضافية</label>
                        <textarea name="notes" class="form-control" rows="3"/>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">إرسال طلب التسجيل</button>
                </form>
            </div>
        </t>
    </template>

    <template id="provider_register_thankyou_template" name="Provider Registration Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center" dir="rtl">
                <h2>تم استلام طلب تسجيلك</h2>
                <p class="text-muted">سيتم مراجعة طلبك من قبل إدارة المنصة والتواصل معك بعد الاعتماد.</p>
                <a href="/exchange" class="btn btn-primary">العودة إلى البورصة</a>
            </div>
        </t>
    </template>

</odoo>
