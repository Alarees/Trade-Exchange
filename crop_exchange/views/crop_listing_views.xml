<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crop_listing_list" model="ir.ui.view">
        <field name="name">crop.listing.list</field>
        <field name="model">crop.listing</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='expired'" decoration-warning="state=='reserved'">
                <field name="crop_id"/>
                <field name="provider_id"/>
                <field name="quantity"/>
                <field name="uom"/>
                <field name="price_per_unit" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state_province"/>
                <field name="interest_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_crop_listing_form" model="ir.ui.view">
        <field name="name">crop.listing.form</field>
        <field name="model">crop.listing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_reserved" string="Mark Reserved" type="object" invisible="state != 'available'"/>
                    <button name="action_mark_available" string="Mark Available" type="object" invisible="state != 'reserved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(crop_exchange.action_crop_interest)d" type="action" class="oe_stat_button" icon="fa-envelope" context="{'default_listing_id': id}">
                            <field name="interest_count" widget="statinfo" string="Interests"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="crop_id"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                        </group>
                        <group>
                            <field name="price_per_unit"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="quality_grade"/>
                            <field name="state_province"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crop_listing_kanban" model="ir.ui.view">
        <field name="name">crop.listing.kanban</field>
        <field name="model">crop.listing</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="crop_id"/>
                        <div class="o_kanban_record_title"><field name="name"/></div>
                        <div><field name="price_per_unit" widget="monetary"/> / <field name="uom"/></div>
                        <div><field name="state_province"/></div>
                        <field name="state" widget="label_selection"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_crop_listing" model="ir.actions.act_window">
        <field name="name">Listings</field>
        <field name="res_model">crop.listing</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No crop listings yet.</p>
        </field>
    </record>
</odoo>
