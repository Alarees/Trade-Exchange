<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crop_provider_list" model="ir.ui.view">
        <field name="name">crop.provider.list</field>
        <field name="model">crop.provider</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='rejected'" decoration-success="state=='approved'" decoration-info="state=='pending'">
                <field name="name"/>
                <field name="entity_type"/>
                <field name="phone"/>
                <field name="state_province"/>
                <field name="listing_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_crop_provider_form" model="ir.ui.view">
        <field name="name">crop.provider.form</field>
        <field name="model">crop.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state == 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state == 'rejected'"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object" invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(crop_exchange.action_crop_listing)d" type="action" class="oe_stat_button" icon="fa-list" context="{'default_provider_id': id}">
                            <field name="listing_count" widget="statinfo" string="Listings"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Business / Provider Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="entity_type"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="whatsapp"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="state_province"/>
                            <field name="country_id"/>
                            <field name="years_experience"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crop_provider_search" model="ir.ui.view">
        <field name="name">crop.provider.search</field>
        <field name="model">crop.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="state_province"/>
                <filter string="Pending Review" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="State/Province" name="group_province" context="{'group_by':'state_province'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crop_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">crop.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No provider registrations yet.</p>
        </field>
    </record>
</odoo>
